# ========================================
# IntelliTraffic AI — Environment Config
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# ---- Application ----
APP_ENV=demo                        # demo | production
APP_SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production
APP_DEBUG=true

# ---- Database ----
# Leave blank to use SQLite (demo default)
DATABASE_URL=
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/intellitraffic

# ---- JWT ----
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- Google APIs (optional — demo mode works without these) ----
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=

# ---- Firebase Cloud Messaging (optional) ----
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=

# ---- SMS Provider (optional) ----
SMS_PROVIDER=mock                   # mock | twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_API_KEY=
MSG91_SENDER_ID=

# ---- Demo Mode ----
DEMO_MODE=true
DEMO_SEED_ON_START=true

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
